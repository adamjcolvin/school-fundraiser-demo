<section class="hero" aria-label="Campaign photograph">
  <% if campaign.image.attached? %>
    <%= image_tag campaign.image,
          class: "hero__image",
          alt: campaign.image_alt %>
  <% else %>
    <div class="hero__fallback" role="img" aria-label="Classroom photograph unavailable"></div>
  <% end %>
  <p class="hero__caption"><%= campaign.location %></p>
</section>
