<% content_for :title, @campaign.title %>
<% content_for :description, @campaign.lede %>

<%= turbo_stream_from @campaign, :donations %>

<%= render "campaigns/hero", campaign: @campaign %>
<%= render "campaigns/progress", campaign: @campaign %>

<main class="page">
  <div class="page__grid">
    <div class="page__story">
      <div class="story"><%= simple_format @campaign.story %></div>

      <%= render "donations/list", campaign: @campaign, donations: @donations %>
    </div>

    <div class="page__give" id="give">
      <%= render "donations/form", campaign: @campaign, donation: @donation %>
    </div>
  </div>
</main>
