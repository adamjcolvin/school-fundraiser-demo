<section class="donor-wall" aria-labelledby="donor-wall-heading" data-controller="donation-list">
  <h2 id="donor-wall-heading">Gifts so far</h2>
  <p class="donor-wall__empty" data-donation-list-target="empty" <%= "hidden" if page.records.any? %>>
    Be the first classroom supporter. Gifts show up here as they are recorded.
  </p>

  <div id="donations" data-donation-list-target="list" aria-live="polite">
    <%= render partial: "donations/donation", collection: page.records %>
    <%= render "donations/more", campaign: campaign, page: page %>
  </div>
</section>
